generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  name          String
  role          String
  city          String?
  /// Quartier ou zone (annuaire, mise en relation client / pro).
  quartier      String?
  phone         String?
  photoUrl      String?
  bio           String?
  servicesTarifs String?
  /// Photo du menu tarifs (data URL ou https) — affichée sur la fiche publique.
  tarifMenuPhotoUrl String?
  salonName     String?
  /// homme | femme — identité du client ou du coiffeur (optionnel côté salon).
  gender        String?
  /// hommes | femmes | tous — clientèle accueillie (optionnel, ancien champ).
  clientele     String?
  /// Types d’activité proposés — JSON ["barbier","coiffeuse",…] (coiffeur / salon).
  proMetiers    Json?
  /// Types de pros recherchés — JSON ["barbier","tresseuse",…] (client).
  rechercheMetiers Json?
  homeVisit     Boolean?
  /// Solde simulé (FCFA) — branchement API Flooz / Moov à prévoir en production.
  balanceFloozFcfa Int @default(0)
  /// Solde simulé (FCFA) — branchement API Mix by Yas à prévoir en production.
  balanceMixFcfa   Int @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sentMessages  Message[]    @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  favoritesAsClient Favorite[] @relation("ClientFavorites")
  favoritesAsPro    Favorite[] @relation("ProFavorites")
  rendezVousAsPro    RendezVous[] @relation("ProRendezVous")
  rendezVousAsClient RendezVous[] @relation("ClientRendezVous")
  /// Demandes « client → pro » avant d’ouvrir la messagerie.
  contactRequestsAsClient ContactRequest[] @relation("ContactRequestClient")
  contactRequestsAsPro    ContactRequest[] @relation("ContactRequestPro")
  rdvMarketplaceSelectionsAsClient RdvMarketplaceSelection[] @relation("RdvMarketplaceSelectionClient")
  rdvMarketplaceSelectionsAsPro    RdvMarketplaceSelection[] @relation("RdvMarketplaceSelectionPro")
}

model Message {
  id        String   @id @default(uuid())
  fromUid   String
  toUid     String
  text      String
  createdAt DateTime @default(now())
  fromUser  User     @relation("SentMessages", fields: [fromUid], references: [id], onDelete: Cascade)
  toUser    User     @relation("ReceivedMessages", fields: [toUid], references: [id], onDelete: Cascade)
}

/// Demande de contact client → pro. Messagerie autorisée seulement si status = accepted.
model ContactRequest {
  id        String   @id @default(uuid())
  clientUid String
  proUid    String
  /// pending | accepted | rejected
  status    String   @default("pending")
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    User     @relation("ContactRequestClient", fields: [clientUid], references: [id], onDelete: Cascade)
  pro       User     @relation("ContactRequestPro", fields: [proUid], references: [id], onDelete: Cascade)

  @@unique([clientUid, proUid])
}

model Avis {
  id            String   @id @default(uuid())
  fromClientUid String
  toProUid      String
  rating        Int
  comment       String
  photoUrl      String?
  createdAt     DateTime @default(now())
}

model DemandeDomicile {
  id        String   @id @default(uuid())
  clientUid String
  proUid    String?
  message   String
  createdAt DateTime @default(now())
}

model Offre {
  id          String   @id @default(uuid())
  salonUid    String
  salonName   String?
  title       String
  description String
  city        String?
  /// Quartier ou zone du lieu de travail.
  quartier    String?
  contractType String?
  /// monthly = salaire mensuel ; per_prestation = rémunération à chaque prestation.
  remunerationType String?
  /// Montant mensuel en FCFA (si remunerationType = monthly).
  salaryFcfa       Int?
  /// Précisions (commission, fourchette, avantages…).
  remunerationNote String?
  /// open = visible pour tous ; filled = poste pourvu, masqué pour les autres utilisateurs.
  status      String   @default("open")
  createdAt   DateTime @default(now())
}

model Candidature {
  id          String   @id @default(uuid())
  offerId     String
  coiffeurUid String
  salonUid    String
  message     String?
  createdAt   DateTime @default(now())

  @@unique([offerId, coiffeurUid])
}

model Favorite {
  id        String   @id @default(uuid())
  clientId  String
  proId     String
  createdAt DateTime @default(now())
  client    User     @relation("ClientFavorites", fields: [clientId], references: [id], onDelete: Cascade)
  pro       User     @relation("ProFavorites", fields: [proId], references: [id], onDelete: Cascade)

  @@unique([clientId, proId])
}

model RendezVous {
  id                  String    @id @default(uuid())
  proUid              String
  clientUid           String
  scheduledAt         DateTime
  prestation          String
  status              String    @default("planned")
  proRating           Int?
  proComment          String?
  /// Rempli quand le rappel J-1 (message messagerie) a été envoyé au client.
  reminder24hSentAt   DateTime?
  /// Prix en FCFA (fixé par le pro). Null = non défini, paiement en ligne indisponible.
  priceFcfa           Int?
  /// Part prestation seule (hors articles marketplace). Null = non définie.
  prestationPriceFcfa Int?
  /// unpaid | pending | paid | failed.
  paymentStatus       String    @default("unpaid")
  /// Identifiant de tentative de paiement côté opérateur (ou simulation).
  paymentAttemptId    String?
  paymentProvider     String?
  /// Date de démarrage de la tentative (création checkout / intent).
  paymentRequestedAt  DateTime?
  /// Raison de l’échec (retour opérateur / webhook).
  paymentFailureReason String?
  /// Horodatage d’échec (utile pour relance / support).
  paymentFailedAt     DateTime?
  /// Identifiant de transaction opérateur confirmé par webhook.
  paymentOperatorTxnId String?
  paidAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  pro          User     @relation("ProRendezVous", fields: [proUid], references: [id], onDelete: Cascade)
  client       User     @relation("ClientRendezVous", fields: [clientUid], references: [id], onDelete: Cascade)
  marketplaceSelection RdvMarketplaceSelection?
}

model Product {
  id          String   @id @default(uuid())
  sellerUid   String
  sellerName  String
  title       String
  description String
  priceFcfa   Int
  stock       Int      @default(1)
  /// Unités vendues (cumul, hors annulations ultérieures gérées au remboursement stock).
  unitsSold   Int      @default(0)
  category    String?
  photoUrl    String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Sélection d’articles marketplace liée à un rendez-vous précis (hors commande).
model RdvMarketplaceSelection {
  id               String   @id @default(uuid())
  rendezVousId     String   @unique
  clientUid        String
  proUid           String
  itemsCount       Int      @default(0)
  itemsSubtotalFcfa Int     @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  rendezVous       RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  client           User       @relation("RdvMarketplaceSelectionClient", fields: [clientUid], references: [id], onDelete: Cascade)
  pro              User       @relation("RdvMarketplaceSelectionPro", fields: [proUid], references: [id], onDelete: Cascade)
  lines            RdvMarketplaceSelectionLine[]
}

model RdvMarketplaceSelectionLine {
  id               String   @id @default(uuid())
  selectionId      String
  productId        String
  productTitle     String
  unitPriceFcfa    Int
  quantity         Int
  lineTotalFcfa    Int
  createdAt        DateTime @default(now())
  selection        RdvMarketplaceSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
}

model MarketOrder {
  id                String   @id @default(uuid())
  buyerUid          String
  sellerUid         String
  sellerName        String?
  buyerName         String?
  status            String   @default("pending")
  subtotalFcfa      Int
  platformFeeFcfa   Int
  sellerNetFcfa     Int
  platformFeeRateBp Int      @default(1000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  items             MarketOrderItem[]
}

model MarketOrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  sellerUid    String
  buyerUid     String
  productTitle String
  unitPriceFcfa Int
  quantity     Int
  lineTotalFcfa Int
  createdAt    DateTime @default(now())
  order        MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
